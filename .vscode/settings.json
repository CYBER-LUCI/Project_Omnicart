            "ssh": "Disabled",
            "previewLimit": 50,
            "server": "localhost",
            "port": 3306,
            "driver": "MySQL",
            "name": "OmniDB Conn",
            "database": "mysql",
            "username": "root",
            "password": "root"
        }
    ]
}